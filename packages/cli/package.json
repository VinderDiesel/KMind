{
  "name": "@kmind/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "kmind": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kmind/adapter-claude-code": "workspace:*",
    "@kmind/adapter-codex": "workspace:*",
    "@kmind/adapter-cursor": "workspace:*",
    "@kmind/adapter-qoder": "workspace:*",
    "@kmind/core": "workspace:*",
    "@kmind/mcp-server": "workspace:*",
    "@kmind/shared": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
